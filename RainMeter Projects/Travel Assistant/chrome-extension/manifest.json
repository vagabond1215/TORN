{
  "manifest_version": 3,
  "name": "Torn Travel Assistant Notifications",
  "version": "0.1.0",
  "description": "Displays local Chrome notifications for modeled Torn foreign-stock windows generated by Travel Assistant.",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "file:///*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Torn Travel Alerts",
    "default_popup": "popup.html"
  }
}
