; Transparent hover bands over the one expanded inline graph.
; GraphHover.lua positions these inside the rendered plot and assigns time/stock tooltips.

[GraphHoverStyle]
Group=InlineGraphHover
X=0
Y=0
Hidden=1
DynamicVariables=1
Shape=Rectangle 0,0,1,1 | Fill Color 0,0,0,1 | StrokeWidth 0
ToolTipTitle=Stock history
ToolTipText=
ToolTipWidth=220

[MeterGraphHover01]
Meter=Shape
MeterStyle=GraphHoverStyle
