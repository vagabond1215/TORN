; Global transparent hover targets for the single expanded inline graph.
; StateReader.lua positions only the active regions published by RenderInlineGraph.ps1.
; Keeping these global avoids multiplying hover meters across all eight opportunity rows.

[MeterGraphHover1]
Meter=Shape
Group=GraphHover
X=0
Y=0
W=1
H=1
Hidden=1
DynamicVariables=1
Shape=Rectangle 0,0,1,1 | Fill Color 0,0,0,1 | StrokeWidth 0
ToolTipText=
ToolTipWidth=280
LeftMouseUpAction=

